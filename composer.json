{
    "name": "inilim/tools",
    "description": "",
    "type": "library",
    "autoload": {
        "psr-4": {
            "Inilim\\Tool\\": "src/"
        },
        "files": []
    },
    "extra": {
        "exclude-from-files": [
            "symfony/var-dumper/Resources/functions/dump.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Inilim\\Tool\\Test\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "inilim"
        },
        {
            "name": "internet community"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-mbstring": "*"
    },
    "suggest": {
        "ext-zip": "TODO ...",
        "ext-xml": "TODO ...",
        "ext-intl": "TODO ..."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "@stable",
        "inilim/dump": "dev-main",
        "phpunit/phpunit": "^11.5",
        "inilim/ipdo": "dev-main",
        "php-code-minifier/php-code-minifier": "^1.2",
        "dragon-code/benchmark": "^3.0",
        "twig/twig": "^3.19",
        "mcaskill/composer-exclude-files": "^4.0"
    },
    "scripts": {
        "unit": [
            "php vendor/bin/phpunit"
        ],
        "unit-tests": [
            "php vendor/bin/phpunit tests"
        ],
        "stan": [
            "php vendor/bin/phpstan"
        ],
        "stan-check": [
            "php vendor/bin/phpstan analyze"
        ]
    },
    "config": {
        "allow-plugins": {
            "mcaskill/composer-exclude-files": true
        }
    }
}
